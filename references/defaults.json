{
  "schema": 2,
  "name": "My style",
  "content_type": "other",
  "format": {
    "orientation": "vertical",
    "aspect_ratio": "9:16",
    "width": 1080,
    "height": 1920,
    "fps": "source",
    "video_bitrate": "5M"
  },
  "language": {
    "primary": "auto",
    "secondary": [],
    "mode": "auto"
  },
  "captions": {
    "mode": "phrase_chunks",
